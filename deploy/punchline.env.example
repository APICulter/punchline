# Environment for Punchline (systemd: /etc/punchline/punchline.env, chmod 600).
# These values override config.properties.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://punchline.example.com
TRUST_PROXY=loopback
MONGODB_URI=mongodb://127.0.0.1:27017/punchline
# Optional AI question generation (README, "Questions"). Empty key = off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
AI_MAX_PER_HOUR=
AI_AUTO_TOPUP=
AI_TOPUP_THRESHOLD=
AI_TOPUP_BATCH=
AI_AUTO_APPROVE=
