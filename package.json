{
  "name": "punchline",
  "version": "1.0.0",
  "description": "Multiplayer party game inspired by \"Use Your Words\" (Node.js, Express, Socket.io, MongoDB)",
  "main": "app.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "build:css": "postcss ./src/input.css -o ./public/css/style.css",
    "dev": "postcss ./src/input.css -o ./public/css/style.css --watch",
    "admin:password": "node admin/hash-password.js",
    "db:seed": "node db/seed.js",
    "test": "node test/smoke.js",
    "test:smoke": "node test/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APICulter/punchline.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/APICulter/punchline/issues"
  },
  "homepage": "https://github.com/APICulter/punchline#readme",
  "dependencies": {
    "express": "^4.22.3",
    "isomorphic-dompurify": "^4.6.0",
    "mongoose": "^7.8.13",
    "properties-reader": "^2.3.0",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "postcss-cli": "^10.1.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19"
  }
}
