databaseUrl = mongodb://127.0.0.1:27017/punchline
# Address shown to players ("On your phone, open ..."). Leave empty to use the
# address the host opened (localhost is replaced by this machine's network IP).
# In production, set it here or with the PUBLIC_URL environment variable.
punchlineURL =
applicationPort = 3000
maxNumberOfPlayers = 3
# max 15 caracters for premium code
premiumCode = change-me

# Default timers, in seconds. The host can change the two first ones in the lobby,
# for each game; these values are the defaults of the lobby sliders.
# Time to write an answer: min 30, max 150 (2:30), by steps of 10
questionCountDown = 60
# Time each answer stays on the big screen during the reveals: min 10, max 30
revealTime = 10
beforeQuestionCountDown = 6
voteCountDown = 10

errorRoomFullMessage = The room is full !
noGameFoundMessage = Invalid PIN
emptyPinMessage = Empty PIN
onlyNumbersMessage = Only numbers 1
fourDigitPinMessage = 4 digit PIN
botName = bot
unauthorizedNameMessage = Unauthorized name
userExistsMessage = This name is already taken
premiumCodeErrorMessage = Invalid code

nbOfQuestionsErrorMessage = invalid number of rounds
answerTimeErrorMessage = invalid answer time
revealTimeErrorMessage = invalid reveal time
premiumCodeLengthErrorMessage = length error

answerEmptyErrorMessage = please answer
answerTooLongErrorMessage = answer too long


