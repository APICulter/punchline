databaseUrl = mongodb://127.0.0.1:27017/punchline
# Address shown to players ("On your phone, open ..."). Leave empty to use the
# address the host opened (localhost is replaced by this machine's network IP).
# In production, set it here or with the PUBLIC_URL environment variable.
punchlineURL =
applicationPort = 3000
maxNumberOfPlayers = 3
# Premium code: INITIAL value only. At the first start it is copied into MongoDB
# (collection "settings"); afterwards it is managed in the admin panel (/admin,
# "Settings" tab: generate, change, disable) and this key is ignored.
# 4 to 15 characters: letters, digits, dashes. Leave empty (or change-me, ignored):
# premium is off until a code is set in the panel.
premiumCode = change-me

# Default timers, in seconds. The host can change the two first ones in the lobby,
# for each game; these values are the defaults of the lobby sliders.
# Time to write an answer: min 30, max 150 (2:30), by steps of 10
questionCountDown = 60
# Time each answer stays on the big screen during the reveals: min 10, max 30
revealTime = 10
beforeQuestionCountDown = 6
voteCountDown = 10

# Name players cannot take (reserved for the bot), case insensitive
botName = bot

# Messages shown to players are no longer set here: the server sends message keys
# (e.g. "error.roomFull") that the browser translates, see public/js/i18n.js.

# Admin panel (/admin). Leave empty to turn it off. The ADMIN_USER and
# ADMIN_PASSWORD_HASH environment variables take precedence over these keys.
# Create the hash with: npm run admin:password   (never put the password itself here)
adminUser =
adminPasswordHash =

# Optional AI question generation in the admin panel (README, "Questions"). Leave the key
# empty to turn it off. Environment variables (ANTHROPIC_API_KEY, ANTHROPIC_MODEL,
# ANTHROPIC_EFFORT, AI_MAX_PER_HOUR, AI_AUTO_TOPUP, AI_TOPUP_THRESHOLD, AI_TOPUP_BATCH,
# AI_AUTO_APPROVE) take precedence over these keys.
anthropicApiKey =
# default claude-sonnet-5-5
anthropicModel =
# low | medium (default) | high | xhigh | max | default
anthropicEffort =
# generations per hour, default 10
aiMaxPerHour =
# true: background top-up when a language runs low (default off)
aiAutoTopup =
# default 100 approved questions not played for 30 days
aiTopupThreshold =
# questions per automatic batch, default 20
aiTopupBatch =
# true: automatic batches are approved without review (default: pending)
aiAutoApprove =
